{
  "display_information": {
    "name": "Edison",
    "description": "Edison insights in Slack",
    "background_color": "#048bde",
    "long_description": "Edison brings your data into Slack, so your team can get answers without context switching. Connect data sources, pick dashboards or projects, ask questions in plain English, and get clear, shareable insights with links back to Edison."
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Edison",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/smartchart",
        "url": "https://api.your-smartchart-url.com/apps/slack/commands",
        "description": "Edison commands",
        "usage_hint": "help | connect | disconnect | status",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://client.your-smartchart-url.com/integrations/auth/slack/callback"
    ],
      "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "chat:write.public",
        "im:write",
        "users:read",
        "app_mentions:read",
        "channels:read",
        "groups:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://api.your-smartchart-url.com/apps/slack/events",
      "bot_events": [
        "app_home_opened",
        "app_mention"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://api.your-smartchart-url.com/apps/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}